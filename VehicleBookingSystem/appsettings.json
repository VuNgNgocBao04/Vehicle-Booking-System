{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=VehicleBookingSystem;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "StartupOptions": {
    "ApplyMigrationsOnStartup": false,
    "SeedOnStartup": false
  },
  "SessionOptions": {
    "IdleTimeoutMinutes": 30
  },
  "Jwt": {
    "Issuer": "VehicleBookingSystem",
    "Audience": "VehicleBookingSystem.Client",
    "ExpireMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
