@model VehicleBookingSystem.ViewModels.CustomerVehicleIndexViewModel
@inject IHtmlSanitizerService HtmlSanitizer

@{
    var isListView = string.Equals(Model.Filter.ViewMode, "list", StringComparison.OrdinalIgnoreCase);
}

<div class="row g-3 @(isListView ? "vehicle-list-item" : string.Empty)">
    @if (!Model.Vehicles.Items.Any())
    {
        <div class="col-12">
            <div class="alert alert-secondary mb-0">No vehicles matched your filters.</div>
        </div>
    }
    else
    {
        @foreach (var vehicle in Model.Vehicles.Items)
        {
            <div class="@(isListView ? "col-12" : "col-md-6 col-xl-4")">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <div class="row g-3 align-items-center">
                            <div class="@(isListView ? "col-md-4" : "col-12")">
                                <img src="@(string.IsNullOrWhiteSpace(vehicle.ImageUrl) ? "https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=900&q=80" : vehicle.ImageUrl)"
                                     loading="lazy"
                                     class="vehicle-card-img"
                                     alt="@vehicle.Brand @vehicle.Model" />
                            </div>
                            <div class="@(isListView ? "col-md-8" : "col-12")">
                                <h5 class="card-title mb-1">@vehicle.Brand @vehicle.Model</h5>
                                <div class="text-muted small mb-2">@vehicle.LicensePlate | @vehicle.VehicleCategory?.Name</div>
                                <div class="vehicle-rating mb-2" aria-label="rating">★ ★ ★ ★ ☆</div>
                                <p class="mb-1"><span class="price-chip">@vehicle.DailyRate.ToString("N0") VND/day</span></p>
                                <p class="mb-2"><strong>Seats:</strong> @vehicle.SeatCount</p>
                                @if (!string.IsNullOrWhiteSpace(vehicle.Description))
                                {
                                    <div class="text-muted small mb-2">@Html.Raw(HtmlSanitizer.Sanitize(vehicle.Description))</div>
                                }
                                <div class="d-flex gap-2 flex-wrap">
                                    <a class="btn btn-sm btn-primary" asp-controller="Booking" asp-action="Create" asp-route-vehicleId="@vehicle.Id">Book now</a>
                                    <a class="btn btn-sm btn-outline-dark" asp-controller="Customer" asp-action="Details" asp-route-id="@vehicle.Id">Details</a>
                                    <button type="button" class="btn btn-sm btn-outline-secondary js-load-comments" data-vehicle-id="@vehicle.Id">Load comments</button>
                                </div>
                            </div>
                        </div>
                        <div id="comments-@vehicle.Id" class="mt-2"></div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@if (Model.Vehicles.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination mb-0">
            @for (var i = 1; i <= Model.Vehicles.TotalPages; i++)
            {
                <li class="page-item @(Model.Vehicles.Page == i ? "active" : string.Empty)">
                    <a class="page-link js-page-link"
                       href="@Url.Action("Index", "Customer", new
                       {
                           page = i,
                           pageSize = Model.Vehicles.PageSize,
                           searchTerm = Model.Filter.SearchTerm,
                           vehicleCategoryId = Model.Filter.VehicleCategoryId,
                           brand = Model.Filter.Brand,
                           minDailyRate = Model.Filter.MinDailyRate,
                           maxDailyRate = Model.Filter.MaxDailyRate,
                           seatCount = Model.Filter.SeatCount,
                           sortBy = Model.Filter.SortBy,
                           viewMode = Model.Filter.ViewMode
                       })">@i</a>
                </li>
            }
        </ul>
    </nav>
}
