@model VehicleBookingSystem.ViewModels.BookingHistoryIndexViewModel

@{
    ViewData["Title"] = "My Bookings";
}

<div class="py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h4 mb-0">My Bookings</h1>
        <a class="btn btn-outline-secondary" asp-controller="Customer" asp-action="Index">Browse Vehicles</a>
    </div>

    <form method="get" class="card card-body mb-3 border-0 shadow-sm">
        <div class="row g-2">
            <div class="col-md-8">
                <input name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search by code or plate" />
            </div>
            <div class="col-md-2">
                <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<VehicleBookingSystem.Models.BookingStatus>()">
                    <option value="">All status</option>
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-dark w-100" type="submit">Filter</button>
            </div>
        </div>
    </form>

    <div class="table-responsive card border-0 shadow-sm">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Vehicle</th>
                    <th>Period</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Bookings.Items.Any())
            {
                <tr><td colspan="6" class="text-center text-muted">No booking history yet.</td></tr>
            }
            else
            {
                @foreach (var booking in Model.Bookings.Items)
                {
                    <tr>
                        <td>@booking.BookingCode</td>
                        <td>@booking.Vehicle?.Brand @booking.Vehicle?.Model<br /><small class="text-muted">@booking.Vehicle?.LicensePlate</small></td>
                        <td>@booking.PickupDateTime.ToString("dd/MM/yyyy") - @booking.ReturnDateTime.ToString("dd/MM/yyyy")</td>
                        <td>@booking.TotalAmount.ToString("N0")</td>
                        <td>
                            @{
                                var badgeClass = booking.Status switch
                                {
                                    VehicleBookingSystem.Models.BookingStatus.Pending => "bg-warning text-dark",
                                    VehicleBookingSystem.Models.BookingStatus.Confirmed => "bg-success",
                                    VehicleBookingSystem.Models.BookingStatus.Completed => "bg-primary",
                                    VehicleBookingSystem.Models.BookingStatus.Cancelled => "bg-danger",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @badgeClass">@booking.Status</span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@booking.Id" class="btn btn-sm btn-outline-dark">Details</a>
                            @if (booking.Status == VehicleBookingSystem.Models.BookingStatus.Pending || booking.Status == VehicleBookingSystem.Models.BookingStatus.Confirmed)
                            {
                                <form asp-action="Cancel" asp-route-id="@booking.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-danger" type="submit" onclick="return confirm('Cancel this booking?');">Cancel</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>

    @if (Model.Bookings.TotalPages > 1)
    {
        <nav>
            <ul class="pagination">
                @for (var i = 1; i <= Model.Bookings.TotalPages; i++)
                {
                    <li class="page-item @(Model.Bookings.Page == i ? "active" : string.Empty)">
                        <a class="page-link" asp-action="MyBookings" asp-route-page="@i" asp-route-searchTerm="@Model.SearchTerm" asp-route-status="@Model.Status">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>
