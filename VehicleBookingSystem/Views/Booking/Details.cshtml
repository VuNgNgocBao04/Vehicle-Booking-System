@model VehicleBookingSystem.Models.Booking

@{
    ViewData["Title"] = "Booking Details";
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
                <h1 class="h4 mb-1">@Model.BookingCode</h1>
                <div class="text-muted">Created @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
            </div>
            <span class="badge bg-secondary">@Model.Status</span>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <div><strong>Vehicle:</strong> @Model.Vehicle?.Brand @Model.Vehicle?.Model</div>
                <div><strong>Plate:</strong> @Model.Vehicle?.LicensePlate</div>
                <div><strong>Total:</strong> @Model.TotalAmount.ToString("N0") VND</div>
            </div>
            <div class="col-md-6">
                <div><strong>Pickup:</strong> @Model.PickupDateTime.ToString("dd/MM/yyyy")</div>
                <div><strong>Return:</strong> @Model.ReturnDateTime.ToString("dd/MM/yyyy")</div>
                <div><strong>Pickup location:</strong> @Model.PickupLocation</div>
                <div><strong>Dropoff location:</strong> @Model.DropoffLocation</div>
            </div>
        </div>

        <div class="mt-3 d-flex gap-2">
            <a asp-action="MyBookings" class="btn btn-outline-secondary">Back</a>
            @if (Model.Status == VehicleBookingSystem.Models.BookingStatus.Pending || Model.Status == VehicleBookingSystem.Models.BookingStatus.Confirmed)
            {
                <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger" onclick="return confirm('Cancel this booking?');">Cancel booking</button>
                </form>
            }
        </div>
    </div>
</div>
