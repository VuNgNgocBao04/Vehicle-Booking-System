@model VehicleBookingSystem.Models.Booking

@{
    ViewData["Title"] = "Booking Confirmed";
}

<div class="card border-0 shadow-sm py-4 px-3">
    <div class="text-success fs-1 mb-2"><i class="fa-solid fa-circle-check"></i></div>
    <h1 class="h3">Booking created successfully</h1>
    <p class="text-muted">Your booking has been submitted. We will notify you once it is confirmed.</p>

    <div class="row g-3 mt-1">
        <div class="col-md-6">
            <div class="card border-0 bg-light h-100">
                <div class="card-body">
                    <div><strong>Booking Code:</strong> @Model.BookingCode</div>
                    <div><strong>Status:</strong> @Model.Status</div>
                    <div><strong>Total:</strong> @Model.TotalAmount.ToString("N0") VND</div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 bg-light h-100">
                <div class="card-body">
                    <div><strong>Vehicle:</strong> @Model.Vehicle?.Brand @Model.Vehicle?.Model</div>
                    <div><strong>Pickup:</strong> @Model.PickupDateTime.ToString("dd/MM/yyyy")</div>
                    <div><strong>Return:</strong> @Model.ReturnDateTime.ToString("dd/MM/yyyy")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3 d-flex gap-2">
        <a asp-action="MyBookings" class="btn btn-primary">View my bookings</a>
        <a asp-controller="Customer" asp-action="Index" class="btn btn-outline-secondary">Continue browsing</a>
    </div>
</div>
