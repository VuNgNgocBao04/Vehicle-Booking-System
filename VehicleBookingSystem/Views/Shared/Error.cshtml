@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title ?? "Error";
}

<div class="container py-5">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4 p-md-5">
            <p class="text-uppercase text-muted small mb-2">Error @Model.StatusCode</p>
            <h1 class="h3 text-danger mb-3">@(Model.Title ?? "An error occurred while processing your request.")</h1>

            @if (!string.IsNullOrWhiteSpace(Model.Detail))
            {
                <p class="mb-3">@Model.Detail</p>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Instance))
            {
                <p class="mb-2"><strong>Path:</strong> @Model.Instance</p>
            }

            @if (Model.ShowRequestId)
            {
                <p class="mb-0"><strong>Trace ID:</strong> <code>@Model.RequestId</code></p>
            }
        </div>
    </div>
</div>
