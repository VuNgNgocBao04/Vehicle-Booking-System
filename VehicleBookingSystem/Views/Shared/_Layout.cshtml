@using System.Globalization
@inject Microsoft.Extensions.Localization.IStringLocalizer<VehicleBookingSystem.Resources.SharedResource> L

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var pageTitle = ViewData["Title"]?.ToString() ?? "Vehicle Booking";
    var currentCulture = CultureInfo.CurrentUICulture.Name;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vehicle Booking System</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/VehicleBookingSystem.styles.css" asp-append-version="true" />
</head>
<body class="user-layout">
    <header class="user-topbar sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container">
                <a class="navbar-brand fw-bold text-uppercase" asp-area="" asp-controller="Home" asp-action="Index">Vehicle Booking</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#userNav" aria-controls="userNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="userNav">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                        <li class="nav-item"><a class="nav-link @(currentController == "Home" ? "active" : string.Empty)" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link @(currentController == "Customer" ? "active" : string.Empty)" asp-controller="Customer" asp-action="Index">Vehicles</a></li>
                        <li class="nav-item"><a class="nav-link @(currentController == "Booking" ? "active" : string.Empty)" asp-controller="Booking" asp-action="MyBookings">Bookings</a></li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item"><a class="btn btn-outline-light btn-sm btn-action px-3" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">@L["Admin"]</a></li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2 ms-lg-3 mt-3 mt-lg-0">
                        <form asp-controller="Localization" asp-action="SetLanguage" method="post" class="d-flex align-items-center gap-2 mb-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <label for="userCulture" class="small text-white-50 mb-0">@L["Language"]</label>
                            <select id="userCulture" name="culture" class="form-select form-select-sm" onchange="this.form.submit()">
                                <option value="vi-VN" selected="@(currentCulture == "vi-VN")">@L["Vietnamese"]</option>
                                <option value="en-US" selected="@(currentCulture == "en-US")">@L["English"]</option>
                            </select>
                        </form>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form asp-controller="Account" asp-action="Logout" method="post" class="mb-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-light btn-sm btn-action px-3">Logout</button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-outline-light btn-sm btn-action px-3" asp-controller="Account" asp-action="Login">Login</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="user-shell">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb app-breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                @if (!string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase))
                {
                    <li class="breadcrumb-item"><a asp-controller="@currentController" asp-action="Index">@currentController</a></li>
                }
                <li class="breadcrumb-item active" aria-current="page">@pageTitle</li>
            </ol>
        </nav>

        @RenderBody()
    </main>

    <footer class="user-footer">
        <div class="container d-flex flex-column flex-md-row justify-content-between gap-2">
            <span>Book smarter, ride better.</span>
            <span>&copy; 2026 Vehicle Booking System</span>
        </div>
    </footer>

    <div id="globalLoadingOverlay" class="global-loading-overlay d-none" aria-hidden="true">
        <div class="spinner-border text-light" role="status"></div>
        <div class="mt-2">Loading...</div>
    </div>

    <div id="appToastContainer" class="toast-container position-fixed top-0 end-0 p-3">
        @if (TempData["Message"] is string toastMessage)
        {
            <div class="toast text-bg-success border-0" role="alert" data-bs-delay="3500" data-autoshow="true">
                <div class="d-flex"><div class="toast-body">@toastMessage</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button></div>
            </div>
        }
        @if (TempData["Error"] is string toastError)
        {
            <div class="toast text-bg-danger border-0" role="alert" data-bs-delay="4500" data-autoshow="true">
                <div class="d-flex"><div class="toast-body">@toastError</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button></div>
            </div>
        }
    </div>

    <button type="button" id="scrollTopButton" class="btn btn-primary scroll-top-btn" aria-label="@L["ScrollTop"]">
        <i class="fa-solid fa-arrow-up"></i>
    </button>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
