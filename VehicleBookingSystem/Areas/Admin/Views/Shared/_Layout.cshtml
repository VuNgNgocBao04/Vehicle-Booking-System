@using System.Globalization
@inject Microsoft.Extensions.Localization.IStringLocalizer<VehicleBookingSystem.Resources.SharedResource> L

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @L["Admin"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/VehicleBookingSystem.styles.css" asp-append-version="true" />
</head>
<body class="admin-layout">
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
        var pageTitle = ViewData["Title"]?.ToString() ?? "Admin";
        var currentCulture = CultureInfo.CurrentUICulture.Name;
        var returnUrl = Context.Request.Path + Context.Request.QueryString;
    }
    <div class="admin-app">
        <aside class="admin-sidebar" id="adminSidebar">
            <div class="admin-brand">
                <div class="admin-brand-mark"></div>
                <div>
                    <div class="text-uppercase small text-white-50">Admin template</div>
                    <div class="h5 mb-0">Vehicle Booking</div>
                </div>
            </div>

            <nav class="nav flex-column">
                <a class="nav-link @(currentController == "Dashboard" ? "active" : string.Empty)" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <span>Dashboard</span>
                    <span>01</span>
                </a>
                <a class="nav-link @(currentController == "Vehicle" ? "active" : string.Empty)" asp-area="Admin" asp-controller="Vehicle" asp-action="Index">
                    <span>Xe</span>
                    <span>02</span>
                </a>
                <a class="nav-link @(currentController == "Booking" ? "active" : string.Empty)" asp-area="Admin" asp-controller="Booking" asp-action="Index">
                    <span>Đặt xe</span>
                    <span>03</span>
                </a>
                <a class="nav-link" asp-area="" asp-controller="Customer" asp-action="Index">
                    <span>Khách hàng</span>
                    <span>04</span>
                </a>
                <a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <span>Báo cáo</span>
                    <span>05</span>
                </a>
                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                    <span>User site</span>
                    <span>↗</span>
                </a>
            </nav>
        </aside>

        <div class="admin-main">
            <header class="admin-topbar">
                <div>
                    <button class="btn btn-outline-light btn-sm d-lg-none mb-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminSidebarCanvas" aria-controls="adminSidebarCanvas"><i class="fa-solid fa-bars"></i></button>
                    <div class="text-uppercase small text-white-50">@L["Admin"]</div>
                    <div class="h4 mb-0">@pageTitle</div>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="badge rounded-pill text-bg-success">System healthy</span>
                    <form asp-area="" asp-controller="Localization" asp-action="SetLanguage" method="post" class="d-flex align-items-center gap-2 mb-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <label for="adminCulture" class="small text-white-50 mb-0">@L["Language"]</label>
                        <select id="adminCulture" name="culture" class="form-select form-select-sm" onchange="this.form.submit()" style="min-width: 135px;">
                            <option value="vi-VN" selected="@(currentCulture == "vi-VN")">@L["Vietnamese"]</option>
                            <option value="en-US" selected="@(currentCulture == "en-US")">@L["English"]</option>
                        </select>
                    </form>
                    <a class="btn btn-outline-light btn-sm" asp-area="" asp-controller="Home" asp-action="Index">View user site</a>
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="btn btn-light btn-sm">Logout</button>
                    </form>
                </div>
            </header>

            <main class="admin-content">
                <nav aria-label="breadcrumb" class="mb-3">
                    <ol class="breadcrumb app-breadcrumb admin-breadcrumb mb-0">
                        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">@L["Admin"]</a></li>
                        <li class="breadcrumb-item active" aria-current="page">@pageTitle</li>
                    </ol>
                </nav>
                @RenderBody()
            </main>
        </div>
    </div>

    <div class="offcanvas offcanvas-start text-bg-dark" tabindex="-1" id="adminSidebarCanvas" aria-labelledby="adminSidebarCanvasLabel">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title" id="adminSidebarCanvasLabel">Admin Menu</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <a class="sidebar-link d-block mb-2" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
            <a class="sidebar-link d-block mb-2" asp-area="Admin" asp-controller="Vehicle" asp-action="Index">Xe</a>
            <a class="sidebar-link d-block mb-2" asp-area="Admin" asp-controller="Booking" asp-action="Index">Đặt xe</a>
            <a class="sidebar-link d-block mb-2" asp-area="" asp-controller="Customer" asp-action="Index">Khách hàng</a>
            <a class="sidebar-link d-block mb-2" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Báo cáo</a>
        </div>
    </div>

    <div id="globalLoadingOverlay" class="global-loading-overlay d-none" aria-hidden="true">
        <div class="spinner-border text-light" role="status"></div>
        <div class="mt-2">Loading...</div>
    </div>

    <div id="appToastContainer" class="toast-container position-fixed top-0 end-0 p-3">
        @if (TempData["Message"] is string toastMessage)
        {
            <div class="toast text-bg-success border-0" role="alert" data-bs-delay="3500" data-autoshow="true">
                <div class="d-flex"><div class="toast-body">@toastMessage</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button></div>
            </div>
        }
        @if (TempData["Error"] is string toastError)
        {
            <div class="toast text-bg-danger border-0" role="alert" data-bs-delay="4500" data-autoshow="true">
                <div class="d-flex"><div class="toast-body">@toastError</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button></div>
            </div>
        }
    </div>

    <button type="button" id="scrollTopButton" class="btn btn-primary scroll-top-btn" aria-label="@L["ScrollTop"]">
        <i class="fa-solid fa-arrow-up"></i>
    </button>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>