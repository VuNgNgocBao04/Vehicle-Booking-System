@model VehicleBookingSystem.ViewModels.VehicleFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="row g-3">
    <div class="col-md-4">
        <label asp-for="Code" class="form-label"></label>
        <input asp-for="Code" class="form-control" />
        <span asp-validation-for="Code" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="VehicleCategoryId" class="form-label"></label>
        <select asp-for="VehicleCategoryId" class="form-select" asp-items="ViewBag.CategoryOptions"></select>
        <span asp-validation-for="VehicleCategoryId" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" class="form-select" asp-items="ViewBag.StatusOptions"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Brand" class="form-label"></label>
        <input asp-for="Brand" class="form-control" />
        <span asp-validation-for="Brand" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Model" class="form-label"></label>
        <input asp-for="Model" class="form-control" />
        <span asp-validation-for="Model" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="LicensePlate" class="form-label"></label>
        <input asp-for="LicensePlate" class="form-control" />
        <span asp-validation-for="LicensePlate" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="SeatCount" class="form-label"></label>
        <input asp-for="SeatCount" class="form-control" />
        <span asp-validation-for="SeatCount" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Color" class="form-label"></label>
        <input asp-for="Color" class="form-control" />
        <span asp-validation-for="Color" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Transmission" class="form-label"></label>
        <input asp-for="Transmission" class="form-control" />
        <span asp-validation-for="Transmission" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="FuelType" class="form-label"></label>
        <input asp-for="FuelType" class="form-control" />
        <span asp-validation-for="FuelType" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="DailyRate" class="form-label"></label>
        <input asp-for="DailyRate" class="form-control" />
        <span asp-validation-for="DailyRate" class="text-danger"></span>
    </div>
    <div class="col-md-8">
        <label asp-for="ImageUrl" class="form-label"></label>
        <input asp-for="ImageUrl" class="form-control" />
        <span asp-validation-for="ImageUrl" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="GalleryFiles" class="form-label"></label>
        <input asp-for="GalleryFiles" class="form-control" accept=".jpg,.jpeg,.png,.webp" multiple />
        <div class="form-text">Cho phép nhiều ảnh, mỗi ảnh tối đa 5MB, định dạng jpg/png/webp.</div>
        <span asp-validation-for="GalleryFiles" class="text-danger"></span>

        <div id="galleryPreview" class="d-flex flex-wrap gap-2 mt-2"></div>

        @if (Model.ExistingGalleryUrls.Any())
        {
            <div class="mt-2">
                <div class="small text-muted mb-1">Ảnh hiện tại:</div>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var url in Model.ExistingGalleryUrls)
                    {
                        <img src="@url" alt="Vehicle image" class="rounded border" style="width:120px;height:90px;object-fit:cover;" />
                    }
                </div>
            </div>
        }
    </div>

    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control js-rich-text" rows="6"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="BookingPolicyHtml" class="form-label"></label>
        <textarea asp-for="BookingPolicyHtml" class="form-control js-rich-text" rows="6"></textarea>
        <span asp-validation-for="BookingPolicyHtml" class="text-danger"></span>
    </div>
</div>
