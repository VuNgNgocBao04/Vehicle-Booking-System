@model VehicleBookingSystem.Models.Vehicle

@{
    ViewData["Title"] = "Delete Vehicle";
}

<h1 class="h4 mb-3">Delete Vehicle</h1>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="alert alert-warning">Are you sure you want to delete <strong>@Model.Brand @Model.Model</strong> (@Model.LicensePlate)?</div>

<div class="card card-body mb-3">
    <p class="mb-1"><strong>Code:</strong> @Model.Code</p>
    <p class="mb-1"><strong>Category:</strong> @Model.VehicleCategory?.Name</p>
    <p class="mb-0"><strong>Status:</strong> @Model.Status</p>
</div>

<form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <button class="btn btn-danger" type="submit">Delete</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
</form>
