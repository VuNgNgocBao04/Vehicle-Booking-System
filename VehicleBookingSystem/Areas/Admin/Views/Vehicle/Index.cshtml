@model VehicleBookingSystem.ViewModels.AdminVehicleIndexViewModel

@{
    ViewData["Title"] = "Vehicle Management";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Vehicle Management</h1>
    <a class="btn btn-primary" asp-area="Admin" asp-controller="Vehicle" asp-action="Create">Add Vehicle</a>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<form method="get" class="card card-body mb-3">
    <div class="row g-2">
        <div class="col-md-3">
            <input asp-for="Filter.SearchTerm" class="form-control" placeholder="Search name/plate/code" />
        </div>
        <div class="col-md-2">
            <select asp-for="Filter.VehicleCategoryId" asp-items="Model.CategoryOptions" class="form-select">
                <option value="">All categories</option>
            </select>
        </div>
        <div class="col-md-2">
            <input asp-for="Filter.Brand" class="form-control" placeholder="Brand" />
        </div>
        <div class="col-md-2">
            <input asp-for="Filter.MinDailyRate" class="form-control" placeholder="Min rate" />
        </div>
        <div class="col-md-2">
            <input asp-for="Filter.MaxDailyRate" class="form-control" placeholder="Max rate" />
        </div>
        <div class="col-md-1">
            <button class="btn btn-dark w-100" type="submit">Filter</button>
        </div>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Code</th>
                <th>Vehicle</th>
                <th>Category</th>
                <th>Plate</th>
                <th>Rate/Day</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Vehicles.Items.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted">No vehicles found.</td>
                </tr>
            }
            else
            {
                @foreach (var vehicle in Model.Vehicles.Items)
                {
                    <tr>
                        <td>@vehicle.Code</td>
                        <td>@vehicle.Brand @vehicle.Model</td>
                        <td>@vehicle.VehicleCategory?.Name</td>
                        <td>@vehicle.LicensePlate</td>
                        <td>@vehicle.DailyRate.ToString("N0")</td>
                        <td>@vehicle.Status</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@vehicle.Id">Details</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@vehicle.Id">Edit</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@vehicle.Id">Delete</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (Model.Vehicles.TotalPages > 1)
{
    <nav>
        <ul class="pagination">
            @for (var i = 1; i <= Model.Vehicles.TotalPages; i++)
            {
                <li class="page-item @(Model.Vehicles.Page == i ? "active" : string.Empty)">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-pageSize="@Model.Vehicles.PageSize"
                       asp-route-searchTerm="@Model.Filter.SearchTerm"
                       asp-route-vehicleCategoryId="@Model.Filter.VehicleCategoryId"
                       asp-route-brand="@Model.Filter.Brand"
                       asp-route-minDailyRate="@Model.Filter.MinDailyRate"
                       asp-route-maxDailyRate="@Model.Filter.MaxDailyRate"
                       asp-route-status="@Model.Filter.Status">@i</a>
                </li>
            }
        </ul>
    </nav>
}
