@model VehicleBookingSystem.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<section id="overview" class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="metric-card">
            <div class="text-white-50 text-uppercase small">Total Vehicles</div>
            <div class="metric-value mt-2">@Model.TotalVehicles</div>
            <div class="text-white-50 mt-2">Fleet currently managed</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card">
            <div class="text-white-50 text-uppercase small">Bookings Today</div>
            <div class="metric-value mt-2">@Model.BookingsToday</div>
            <div class="text-white-50 mt-2">New booking requests</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card">
            <div class="text-white-50 text-uppercase small">Revenue This Month</div>
            <div class="metric-value mt-2">@Model.RevenueThisMonth.ToString("N0")</div>
            <div class="text-white-50 mt-2">Paid bookings</div>
        </div>
    </div>
</section>

<section class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="admin-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <div class="text-uppercase small text-white-50">Revenue</div>
                    <h2 class="h4 mb-0">By Month</h2>
                </div>
                <span class="badge rounded-pill text-bg-info">Last 6 months</span>
            </div>
            <canvas id="revenueChart" height="120"></canvas>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="admin-card p-4 h-100">
            <div class="text-uppercase small text-white-50">Bookings by Category</div>
            <h2 class="h4">Distribution</h2>
            <canvas id="categoryChart" height="260"></canvas>

            <div class="text-uppercase small text-white-50 mt-3">Quick actions</div>
            <div class="d-grid gap-3 mt-4">
                <div class="admin-shell-card p-3">
                    <a class="text-white text-decoration-none d-flex justify-content-between" asp-area="Admin" asp-controller="Booking" asp-action="Index">
                        <span>View all bookings</span>
                        <strong>→</strong>
                    </a>
                </div>
                <div class="admin-shell-card p-3">
                    <a class="text-white text-decoration-none d-flex justify-content-between" asp-area="Admin" asp-controller="Vehicle" asp-action="Create">
                        <span>Add new vehicle</span>
                        <strong>+</strong>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="row g-4">
    <div class="col-lg-6">
        <div class="admin-card p-4 h-100">
            <div class="text-uppercase small text-white-50">Recent pending bookings</div>
            <h2 class="h4">Needs processing</h2>
            <ul class="list-unstyled mb-0 small">
                @if (!Model.RecentPendingBookings.Any())
                {
                    <li class="py-2 text-white-50">No pending bookings.</li>
                }
                else
                {
                    @foreach (var item in Model.RecentPendingBookings)
                    {
                        <li class="py-2 border-bottom border-light border-opacity-10 d-flex justify-content-between gap-2">
                            <span>
                                <strong>@item.BookingCode</strong><br />
                                @item.CustomerName - @item.VehicleName
                            </span>
                            <span class="text-end">
                                @item.TotalAmount.ToString("N0")<br />
                                <span class="text-white-50">@item.PickupDateTime.ToString("dd/MM")</span>
                            </span>
                        </li>
                    }
                }
            </ul>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="admin-card p-4 h-100">
            <div class="text-uppercase small text-white-50">Maintenance queue</div>
            <h2 class="h4">Vehicles</h2>
            <ul class="list-unstyled mb-0 small">
                @if (!Model.MaintenanceVehicles.Any())
                {
                    <li class="py-2 text-white-50">No vehicles in maintenance.</li>
                }
                else
                {
                    @foreach (var item in Model.MaintenanceVehicles)
                    {
                        <li class="py-2 border-bottom border-light border-opacity-10 d-flex justify-content-between">
                            <span>@item.VehicleName</span>
                            <span class="text-white-50">@item.LicensePlate</span>
                        </li>
                    }
                }
            </ul>

            <div class="mt-3 small text-white-50">New customers this month: <strong class="text-white">@Model.NewCustomersThisMonth</strong></div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        (function () {
            if (!window.Chart) {
                return;
            }

            const revenueLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueByMonth.Select(item => item.Label)));
            const revenueValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueByMonth.Select(item => item.Value)));
            const categoryLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BookingByCategory.Select(item => item.Label)));
            const categoryValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BookingByCategory.Select(item => item.Value)));

            const revenueCtx = document.getElementById("revenueChart");
            if (revenueCtx) {
                new Chart(revenueCtx, {
                    type: "line",
                    data: {
                        labels: revenueLabels,
                        datasets: [{
                            label: "Revenue",
                            data: revenueValues,
                            borderColor: "#14b8a6",
                            backgroundColor: "rgba(20, 184, 166, 0.2)",
                            fill: true,
                            tension: 0.35
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: { legend: { labels: { color: "#e5eefc" } } },
                        scales: {
                            x: { ticks: { color: "#c7d2fe" } },
                            y: { ticks: { color: "#c7d2fe" } }
                        }
                    }
                });
            }

            const categoryCtx = document.getElementById("categoryChart");
            if (categoryCtx) {
                new Chart(categoryCtx, {
                    type: "pie",
                    data: {
                        labels: categoryLabels,
                        datasets: [{
                            data: categoryValues,
                            backgroundColor: ["#7c3aed", "#14b8a6", "#f59e0b", "#3b82f6", "#ef4444", "#22c55e"]
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: { legend: { labels: { color: "#e5eefc" } } }
                    }
                });
            }
        })();
    </script>
}
